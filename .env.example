# HablaAI Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Configuration
# =============================================================================

# Anthropic API key (required)
ANTHROPIC_API_KEY=your_api_key_here

# Model to use (optional, defaults shown)
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.7

# =============================================================================
# Supabase (required for auth and persistence)
# =============================================================================

# Get these from your Supabase project: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT: Enable Email Provider in Supabase Dashboard
# Go to: Authentication > Providers > Email
# Enable "Email" provider for signup/login to work

# Database connection string from: Settings > Database > Connection string > URI
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Note: Service key is NOT required. Guests get chat only (no progress tracking).
# Authenticated users use RLS for data access.
# SUPABASE_SERVICE_KEY=your-service-key-here  # Only needed for admin scripts

# =============================================================================
# Application
# =============================================================================

# Debug mode (enables detailed error pages, auto-reload)
DEBUG=false

# Allow unverified JWTs (security: keep false in production)
ALLOW_UNVERIFIED_JWT=false

# Server settings
HOST=127.0.0.1
PORT=8000

# =============================================================================
# Feature Flags
# =============================================================================

# Enable voice input (V2 feature)
ENABLE_VOICE_INPUT=false

# Enable spaced repetition (V2 feature)
ENABLE_SPACED_REPETITION=false
