# HablaAI Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Configuration
# =============================================================================

# Anthropic API key (required)
ANTHROPIC_API_KEY=your_api_key_here

# Model to use (optional, defaults shown)
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.7

# =============================================================================
# Supabase (required for auth and persistence)
# =============================================================================

# Get these from your Supabase project: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT: Enable Email Provider in Supabase Dashboard
# Go to: Authentication > Providers > Email
# Enable "Email" provider for signup/login to work

# Database connection string from: Settings > Database > Connection string > URI
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Note: Service key is NOT required. Guests get chat only (no progress tracking).
# Authenticated users use RLS for data access.
# SUPABASE_SERVICE_KEY=your-service-key-here  # Only needed for admin scripts

# =============================================================================
# Application
# =============================================================================

# Secret key for signing cookies (required — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-me-to-a-random-string

# Debug mode (enables detailed error pages, auto-reload)
# WARNING: Set to true only for local development
DEBUG=false

# Allow unverified JWT decode when Supabase is not configured (local dev only)
# WARNING: NEVER set to true in production
ALLOW_UNVERIFIED_JWT=false

# Server settings
HOST=127.0.0.1
PORT=8000

# CORS allowed origins (comma-separated, for production deployments)
# Example: https://habla-hermano.onrender.com,https://custom-domain.com
# Leave empty for same-origin (typical for server-rendered apps)
CORS_ALLOWED_ORIGINS=

# =============================================================================
# Privacy & Data Retention
# =============================================================================

# Salt for deriving the encryption key from SECRET_KEY (PBKDF2)
# Changing this invalidates all previously encrypted data
ENCRYPTION_SALT=habla-hermano-encryption-v1

# Request Anthropic to not retain/log API input/output (adds x-no-store header)
ANTHROPIC_ZERO_RETENTION=false

# Auto-delete conversation data older than N days (0 = disabled)
CONVERSATION_RETENTION_DAYS=0

# Auto-purge LangGraph checkpoints older than N days (0 = disabled)
CHECKPOINT_RETENTION_DAYS=30

# =============================================================================
# Voice Conversation (Optional — Deepgram STT/TTS)
# =============================================================================

# Get your API key from: https://console.deepgram.com
# When set, enables mic button (STT) and speaker icons (TTS) in chat.
# When empty/missing, voice UI is hidden (graceful degradation).
DEEPGRAM_API_KEY=
